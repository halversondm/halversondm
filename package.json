{
  "name": "halversondm",
  "version": "1.0.0",
  "description": "The personal website of Dan Halverson - @halversondm",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/halversondm/halversondm.git"
  },
  "scripts": {
    "clean": "rimraf dist && mkdir dist",
    "start": "webpack serve --config webpack.dev.js",
    "test": "vitest --config vitest.config.js",
    "test:coverage": "vitest --config vitest.config.js --coverage",
    "test:run": "vitest run --config vitest.config.js",
    "lint": "eslint .",
    "prettier": "prettier . --write",
    "prettier:check": "prettier . --check",
    "tsc": "tsc -w",
    "prebuild": "npm run clean && npm run test:run",
    "build": "webpack --config webpack.prod.js",
    "prepare": "husky install"
  },
  "keywords": [
    "react"
  ],
  "author": "Dan Halverson <daniel.m.halverson@gmail.com> (https://halversondm.com/)",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1135.0",
    "@aws-sdk/client-secrets-manager": "^3.1135.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-bootstrap": "^0.26.8",
    "connect-history-api-fallback": "^2.0.0",
    "font-awesome": "^4.7.0",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-router-bootstrap": "^0.26.3",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@vitest/coverage-v8": "*",
    "assert": "^2.1.0",
    "body-parser": "^2.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "file-loader": "^6.2.0",
    "global-jsdom": "^30.0.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "mini-css-extract-plugin": "^2.10.2",
    "msw": "^2.15.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "*",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,tsx,css,md}": "prettier --write"
  },
  "overrides": {
    "minimatch": ">=9.0.7",
    "uuid": ">=11.1.1"
  }
}
