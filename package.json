{
  "name": "halversondm",
  "version": "1.0.0",
  "description": "The personal website of Dan Halverson - @halversondm",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/halversondm/halversondm.git"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=apps/web",
    "start:server": "npm run dev --workspace=apps/server",
    "test": "npm run test --workspace=apps/web",
    "test:coverage": "npm run test:coverage --workspace=apps/web",
    "test:run": "npm run test:run --workspace=apps/web",
    "lint": "eslint .",
    "prettier": "prettier . --write",
    "prettier:check": "prettier . --check",
    "build": "npm run build --workspace=apps/web",
    "prepare": "husky install"
  },
  "author": "Dan Halverson <daniel.m.halverson@gmail.com> (https://halversondm.com/)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,tsx,css,md}": "prettier --write"
  },
  "overrides": {
    "minimatch": ">=9.0.7",
    "uuid": ">=11.1.1"
  }
}
